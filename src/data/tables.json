  "M3": {
   "title": "Table M-3",
   "subtitle": "List of medicaments",
   "source": "Chapter 3, Section 4",
   "note": "Preparations listed may have been substituted by equivalent preparations in the ship’s medicine chest. Latin names are given so that a correct translation can be found in each language. For congestive heart failure, chlorothiazide (500 mg per tablet) and digoxin (0.25 mg per tablet) or equivalents are available on board, but should be used only on medical advice transmitted in plain language and not by code.",
   "groups": [
    {
     "title": "For external use",
     "rows": [
      {
       "n": "1",
       "text": "Ear drops",
       "detail": "Glycerin ear drops (Auristillae Glyceris)."
      },
      {
       "n": "2",
       "text": "Antiseptic eye drops",
       "detail": "Sulfacetamide eye drops (Guttae Sulfacetamidi)."
      },
      {
       "n": "3",
       "text": "Anaesthetic eye drops",
       "detail": "Tetracaine eye drops (Guttae Tetracainae)."
      },
      {
       "n": "4",
       "text": "Salicylate liniment",
       "detail": "Methyl salicylate liniment (Linimentum Methylis Salicylatis)."
      },
      {
       "n": "5",
       "text": "Calamine lotion",
       "detail": "Lotio Calaminae."
      },
      {
       "n": "6",
       "text": "Antiseptic lotion",
       "detail": "Cetrimide lotion (Lotio Cetrimidi)."
      },
      {
       "n": "7",
       "text": "Nasal drops",
       "detail": "Norephedrine hydrochloride drops (Naristillae Ephedrine)."
      },
      {
       "n": "8",
       "text": "Soft paraffin",
       "detail": "Yellow soft paraffin (Paraffinum Molle Flavum)."
      },
      {
       "n": "9",
       "text": "Burn/wound dressing",
       "detail": "Tulle gras dressing (paraffin gauze) (Paraffinum Molle Flavum Carbasi Absorbentis)."
      },
      {
       "n": "10",
       "text": "Antibiotic ointment",
       "detail": "Bacitracin ointment (Unguentum Bacitracini)."
      },
      {
       "n": "11",
       "text": "Pile ointment",
       "detail": "Compound benzocaine ointment (Unguentum Benzocaini Compositum)."
      },
      {
       "n": "12",
       "text": "Local anaesthetic ointment",
       "detail": "Xylocaine ointment (Unguentum Xylocaini Hydrochloridi)."
      }
     ]
    },
    {
     "title": "For internal use: allergic conditions",
     "rows": [
      {
       "n": "13",
       "text": "Antihistamine tablets",
       "detail": "Promethazine hydrochloride tablets (Compressi Promethazini Hydrochloridi). 25 mg per tablet."
      },
      {
       "n": "14",
       "text": "Adrenaline",
       "detail": "Adrenaline injection (Injectio Adrenalini). 1 mg in “Ampins”.",
       "caution": "Caution: use only on medical advice by radio, except in case of anaphylactic shock due to penicillin injection."
      }
     ]
    },
    {
     "title": "For internal use: antibiotics",
     "rows": [
      {
       "n": "15",
       "text": "Tetracycline capsules",
       "detail": "Tetracycline hydrochloride capsules (Capsulae Tetracyclini Hydrochloridi). 250 mg per capsule."
      },
      {
       "n": "16",
       "text": "Penicillin tablets",
       "detail": "Phenoxymethylpenicillin (Compressi Phenoxymethylpenicillini). 125 mg per tablet."
      },
      {
       "n": "17",
       "text": "Sulfonamide tablets",
       "detail": "Sulfadimidine tablets (Compressi Sulfadimidini). 500 mg per tablet."
      },
      {
       "n": "18",
       "text": "Penicillin injection",
       "detail": "Procaine penicillin G (Injectio Benzylpenicillini). 600,000 units per ampoule."
      },
      {
       "n": "19",
       "text": "Streptomycin injection",
       "detail": "Streptomycin sulfate injection (Injectio Streptomycini Sulfatis). 1,000 mg per ampoule."
      },
      {
       "n": "20",
       "text": "Tetracycline injection",
       "detail": "Tetracycline hydrochloride (Injectio Tetracyclini Hydrochloridi). 100 mg per ampoule."
      }
     ]
    },
    {
     "title": "For internal use: asthma",
     "rows": [
      {
       "n": "21",
       "text": "Asthma relief tablets",
       "detail": "Aminophylline tablets (Compressi Aminophyllini). 300 mg per tablet.",
       "caution": "Caution: use only on medical advice by radio."
      },
      {
       "n": "22",
       "text": "Ephedrine tablets",
       "detail": "Ephedrine hydrochloride tablets (Compressi Ephedrini Hydrochloridi). 30 mg per tablet."
      },
      {
       "n": "23",
       "text": "Inhalation mixture",
       "detail": "Tincture of benzoin compound (Tinctura Benzoini Composita)."
      }
     ]
    },
    {
     "title": "For internal use: cough",
     "rows": [
      {
