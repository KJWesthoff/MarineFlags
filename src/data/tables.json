   "title": "Pratique messages",
   "subtitle": "International Health Regulations",
   "source": "Chapter 2, Section 9",
   "note": "By night a red light over a white light may be shown, where it can best be seen, by vessels requiring health clearance. These lights should only be about 6 feet apart, should be exhibited within the precincts of a port and should be visible all around the horizon as nearly as possible.",
   "groups": [
    {
     "rows": [
      {
       "n": "ZS",
       "text": "My vessel is “healthy” and I request free pratique."
      },
      {
       "n": "ZT",
       "text": "My Maritime Declaration of Health has negative answers to the six Health Questions."
      },
      {
       "n": "ZU",
       "text": "My Maritime Declaration of Health has a positive answer to Health Question(s)… (Health Questions are indicated by complements 1-6)."
      },
      {
       "n": "ZV",
       "text": "I believe I have been in an infected area during the last thirty days."
      },
      {
       "n": "ZW",
       "text": "I require Port Medical Officer."
      },
      {
       "n": "ZW 1",
       "text": "Port Medical Officer will be available at (time indicated)."
      },
      {
       "n": "ZX",
       "text": "You should make the appropriate pratique signal."
      },
      {
       "n": "ZY",
       "text": "You have pratique."
      },
      {
       "n": "ZZ",
       "text": "You should proceed to anchorage for health clearance (at place indicated)."
      },
      {
       "n": "ZZ 1",
       "text": "Where is the anchorage for health clearance?"
      }
     ]
    }
   ]
