  "PASSAGE": {
   "title": "Conditions of innocent passage",
   "subtitle": "Complements to UV 4, UV 5 and UV 6",
   "source": "Chapter 2, Section 5",
   "note": "Signals UV 1 to UV 9 are not mandatory. Use of these signals is not a precondition to the exercise of the right of innocent passage or freedom of navigation.",
   "groups": [
    {
     "rows": [
      {
       "n": "0",
       "text": "By threatening or using force against our/your sovereignty, territorial integrity, or political independence."
      },
      {
       "n": "1",
       "text": "By exercising or practicing with weapons."
      },
      {
       "n": "2",
       "text": "By engaging in acts aimed at collecting information to the prejudice of our/your defense or security."
      },
      {
       "n": "3",
       "text": "By engaging in acts of propaganda aimed at affecting our/your defense or security."
      },
      {
       "n": "4",
       "text": "By engaging in the launching, landing or taking on board of aircraft or a military device."
      },
      {
       "n": "5",
       "text": "By engaging in the loading or unloading of a commodity, currency or person contrary to the customs, fiscal, immigration or sanitary laws or regulations of our/your country."
      },
      {
       "n": "6",
       "text": "By engaging in willful and serious pollution."
      },
      {
       "n": "7",
       "text": "By engaging in fishing activities."
      },
      {
       "n": "8",
       "text": "By engaging in research or survey activities."
      },
      {
       "n": "9",
       "text": "By engaging in acts aimed at interfering with our/your systems of communication or other facilities or installations."
      }
     ]
    }
   ]
  },
